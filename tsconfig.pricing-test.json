{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "esnext"
    ],
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".test-out",
    "rootDir": ".",
    "noEmit": false,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "paths": {
      "server-only": [
        "./scripts/pricing/server-only-stub.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src/server/pricing/**/*.ts",
    "src/lib/pricing/**/*.ts",
    "src/lib/fuzzyMatch.ts",
    "scripts/pricing/**/*.ts"
  ]
}
