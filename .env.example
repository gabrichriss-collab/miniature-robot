# ── Lead notifications (production) ─────────────────────────────────
# Sign up at https://resend.com → "API Keys" → Create → paste here.
# Free tier: 100 emails/day, 3 000/month — plenty for a small business.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# The inbox that receives new leads (default: post@tomrerkawiche.no).
LEAD_TO_EMAIL=post@tomrerkawiche.no

# The "From:" the customer sees on emails you receive. Two options:
#
#  1. Zero-setup (works immediately, may hit spam folders):
#     LEAD_FROM_EMAIL="Tømrer Kawiche · nettsiden <onboarding@resend.dev>"
#
#  2. Proper (requires 10 min DNS setup in Resend dashboard):
#     LEAD_FROM_EMAIL="Tømrer Kawiche <post@tomrerkawiche.no>"
#     — Verify the domain in Resend → Domains → Add tomrerkawiche.no
#     — Paste the SPF + DKIM records into Domeneshop DNS
#     — Wait ~5 min for verification
LEAD_FROM_EMAIL="Tømrer Kawiche · nettsiden <onboarding@resend.dev>"

# ── Optional additional channel (Slack, CRM, Zapier, etc.) ──────────
# Any HTTPS URL accepting POST + JSON. Called in addition to email.
# CONTACT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
